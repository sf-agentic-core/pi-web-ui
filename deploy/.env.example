# ==============================================================================
# pi-web-ui + Tailscale — Variables de Entorno (PLANTILLA)
# ==============================================================================
# Copia este fichero a deploy/.env o inyéctalo en el servidor.
# ==============================================================================

# --- Tailscale AuthKey ---
# Crea una auth key reutilizable / efímera en https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxx

# --- Workspace por defecto ---
# Subcarpeta dentro de /workspace/ (ej. technomad, personal, mms, lmdi, core-agent-library)
PI_WEB_WORKSPACE=technomad

# --- Configuración opcional ---
PI_WEB_PORT=8787
